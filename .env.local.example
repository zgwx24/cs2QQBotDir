# ==================== 环境配置示例 ====================
# 复制此文件为 .env.local 并填入你的实际配置

# ==================== WebSocket 接收器配置 ====================
# NapCat QQ 机器人的 WebSocket 服务地址
WS_URL="ws://127.0.0.1:3001/ws"
# WebSocket 连接令牌
WS_TOKEN="your_ws_token_here"

# ==================== HTTP API 配置 ====================
# NapCat QQ 机器人的 HTTP API 地址
API_URL="http://127.0.0.1:3000"
# HTTP API 访问令牌
API_TOKEN="your_api_token_here"

# ==================== LLM 配置（选择一个） ====================
# 使用 OpenAI GPT
# GPT_API_KEY="sk-proj-xxxxxxxxxxxxx"
# GPT_MODEL="gpt-3.5-turbo"

# 使用 OpenRouter（推荐，免费模型较多）
LLM_API_KEY="sk-or-v1-xxxxxxxxxxxxx"

# ==================== 可选配置 ====================
# MCP Server 配置在 mcp_servers.json 中
# 默认 MCP Weather 服务地址：http://127.0.0.1:8000

# ==================== 群白名单 ====================
# 在 qqbot.py 中配置 GROUP_WHITELIST
# 仅回复白名单内的群，留空或注释则回复所有群
